{
  "name": "@subspace-kit/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warp-oss-org/subspace.git",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev:run": "tsx src/dev/run.ts",
    "test": "vp test",
    "build": "vp pack && tsc -b tsconfig.json --force --emitDeclarationOnly"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@subspace-kit/clock": "workspace:*",
    "@subspace-kit/config": "workspace:*",
    "@subspace-kit/errors": "workspace:*",
    "@subspace-kit/logger": "workspace:*",
    "hono": "^4.12.26",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
