{
  "name": "@subspace/secrets",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warp-oss-org/subspace.git",
    "directory": "packages/secrets"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aws-secrets-manager": {
      "types": "./dist/aws-secrets-manager.d.ts",
      "import": "./dist/aws-secrets-manager.js"
    },
    "./aws-ssm": {
      "types": "./dist/aws-ssm.d.ts",
      "import": "./dist/aws-ssm.js"
    },
    "./gcp": {
      "types": "./dist/gcp.d.ts",
      "import": "./dist/gcp.js"
    }
  },
  "scripts": {
    "test": "vp test",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:down": "docker compose -f docker-compose.test.yml down",
    "build": "vp pack"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@subspace/clock": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.966.0",
    "@aws-sdk/client-ssm": "^3.966.0",
    "@google-cloud/secret-manager": "^6.1.1"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@aws-sdk/client-ssm": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1073.0",
    "@aws-sdk/client-ssm": "^3.1073.0",
    "@google-cloud/secret-manager": "^6.2.0"
  }
}
