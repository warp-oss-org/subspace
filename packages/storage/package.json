{
  "name": "@subspace-kit/storage",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warp-oss-org/subspace.git",
    "directory": "packages/storage"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    },
    "./gcs": {
      "types": "./dist/gcs.d.ts",
      "import": "./dist/gcs.js"
    },
    "./testing/s3": {
      "types": "./dist/testing/s3.d.ts",
      "import": "./dist/testing/s3.js"
    }
  },
  "scripts": {
    "test": "vp test",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:down": "docker compose -f docker-compose.test.yml down",
    "build": "vp pack"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@subspace-kit/clock": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/lib-storage": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@google-cloud/storage": "^7.18.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@google-cloud/storage": "^7.21.0"
  }
}
