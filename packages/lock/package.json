{
  "name": "@subspace/lock",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warp-oss-org/subspace.git",
    "directory": "packages/lock"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    }
  },
  "scripts": {
    "test": "vp test",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:down": "docker compose -f docker-compose.test.yml down",
    "build": "vp pack"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@types/pg": "^8.16.0",
    "pg": "^8.16.3",
    "redis": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "redis": "^6.0.0"
  }
}
